{
  "name": "ombre-lectrice",
  "compatibility_date": "2026-11-26",
  "main": "vocal-worker.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/vocal/*",
      "/manifest.webmanifest",
      "/app-icon.svg",
      "/sw.js",
      "/",
      "/index.html",
      "/speech-worker.mjs"
    ]
  }
}
